# Copy to .env and fill in. .env is gitignored — never commit a real key.
ANTHROPIC_API_KEY=sk-ant-...

# Model used by the Anthropic adapter (Step 6).
GALACTUS_MODEL=claude-sonnet-5

# Max repair attempts before the deterministic truncation fallback takes over.
GALACTUS_MAX_REPAIRS=3

# Logging level for structlog output.
GALACTUS_LOG_LEVEL=INFO
