# Secrets — never commit. The case says lead engineers will read this repo.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local state
*.db
*.sqlite3
.DS_Store

# Hook + review run state — machine-local, regenerated per run
.claude/logs/
.claude/docs/review-findings.jsonl

# Consolidation quarantine — staged for deletion, not shipped
.quarantine/

# Case-study data — personal financial information about identifiable people.
# Never commit. Synthetic fixtures only in tests and docs.
runs/ml/lending/data/
!runs/ml/lending/data/.gitkeep
# runs/ml/lending/docs/report.html is TRACKED, ratified 2026-08-15: it is the only
# real write_report output in the repo and fraud's tests pin markup against it
# (runs/ml/fraud/tests/conftest.py). Private repo; history exposure accepted.
# Phase 2 poc frame: a copy of lebanese-blonde's sample. Real records; never committed.
runs/ml/fraud/data/
# Generated report embeds distributional detail derived from those records — class
# balances, reliability bins, threshold sweeps. Derived from real data is still real data.
runs/ml/fraud/docs/report.html
# Third-party recruiting brief — verbatim copyrighted content, framing restated in code.
runs/ml/customer segmentation/Trade Republic_Data Science Challenge.pdf
# Segment centroids and cluster sizes over 29,096 real customers — aggregates derived
# from real records are still real records, same rationale as the fraud report above.
# The raw CSVs need no rule here: `*.csv` below already covers them.
runs/ml/customer segmentation/docs/
*.csv
*.parquet
*.xlsx

# Trained model artifacts — regenerated from code, never committed
models/
*.pkl
*.joblib
*.cbm
