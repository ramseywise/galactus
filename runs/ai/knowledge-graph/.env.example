# Knowledge-graph run. Copy to .env (gitignored). Every value is optional at load;
# each external dependency refuses by name when its variable is missing.

# Proposer (Haiku) and the Claude judge seat. Unset → both unavailable by name.
ANTHROPIC_API_KEY=
# Jev judge seat via OpenRouter. Unset → the Jev seat is unavailable by name.
OPENROUTER_API_KEY=
# Neo4j store (docker-compose.yml in this dir). Unset → the Neo4j store is unavailable.
NEO4J_URI=

# Corpus and Librarian checkout (defaults shown).
KG_CORPUS_ROOT=~/workspace/librarian/data/wiki
LIBRARIAN_ROOT=~/workspace/librarian

# Models (defaults shown).
KG_PROPOSER_MODEL=claude-haiku-5-5
KG_JUDGE_MODEL=claude-sonnet-5-5

# Spend and routing knobs (defaults shown).
KG_BUILD_CEILING_USD=10
KG_BAND_CEILING_USD=30
KG_BAND_RATE_HALT=0.40
KG_MAX_HOPS=2

# SQLite graph store. Unset → in-memory (tests and dry runs only).
KG_DB_PATH=
