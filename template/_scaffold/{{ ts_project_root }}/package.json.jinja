{
  "name": "{{ project_slug }}-service",
  "version": "0.1.0",
  "description": "{{ project_description }}",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch {{ ts_source_root }}/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:unimported": "node scripts/check-unimported.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"{% if ts_agent_framework == "vercel_ai_sdk" %},
    "eval": "tsx {{ ts_source_root }}/evals/run.ts"{% endif %}
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.0"{% if ts_agent_framework == "vercel_ai_sdk" %},
    "ai": "^7.0.56",
    "@ai-sdk/anthropic": "^4.0.38",
    "zod": "^4.4.3",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^1.27.0"{% endif %}
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.14.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.15.0",
    "vitest": "^3.2.4"
  }
}
