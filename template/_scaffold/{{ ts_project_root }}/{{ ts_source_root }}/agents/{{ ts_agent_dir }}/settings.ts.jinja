/**
 * {{ project_name }} — Vercel AI SDK agent settings.
 *
 * Env-var-driven, same shape as the Python agents' settings.py.jinja
 * (pydantic-settings) — one place to read process.env, everything else
 * imports from here rather than touching process.env directly.
 *
 * No port here — the agent is mounted into the existing Express app
 * (app.ts's POST /agent/chat route), which listens on the app's own PORT.
 * A standalone TS agent service would add its own port setting when that
 * deployment shape actually exists (see Phase 3 of the scaffold plan).
 */

export const settings = {
  anthropicApiKey: process.env.ANTHROPIC_API_KEY ?? "",
  agentModel: process.env.TS_AGENT_MODEL ?? "claude-haiku-4-5-20251001",
  // No temperature setting: thinking-by-default models (Opus 5, Fable 5, Opus
  // 4.8/4.7, Sonnet 5) reject temperature/top_p/top_k with a 400. Steer with
  // the system prompt instead of a sampling knob.
  maxSteps: Number(process.env.TS_AGENT_MAX_STEPS ?? 5),
  /** Outer retry cap for the verification loop — independent of maxSteps. */
  maxRetries: Number(process.env.TS_AGENT_MAX_RETRIES ?? 3),
};
