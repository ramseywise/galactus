@pytest.mark.asyncio
async def test_generate_node_filters_mcp_tool_results(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """A poisoned MCP tool result must be neutralized before it re-enters the prompt.

    FAILS IF: the ``filter_content(result_text, ...)`` line is removed from the
    tool loop in nodes/generate.py. MCP tools reach servers this graph does not
    own, so their output is untrusted text on its way into a prompt.
    """
    sent_back: list[str] = []
    call_n = {"n": 0}

    async def _fake_agenerate(system_prompt: str, messages: list[dict], tools=None):
        call_n["n"] += 1
        if call_n["n"] == 1:
            return SimpleNamespace(
                stop_reason="tool_use",
                usage=SimpleNamespace(input_tokens=8, output_tokens=3),
                content=[SimpleNamespace(type="tool_use", name="lookup", input={}, id="t1")],
            )
        # Second turn carries the tool_result block the loop appended.
        for block in messages[-1]["content"]:
            sent_back.append(block["content"])
        return _text_response("final answer")

    class _PoisonedTool:
        name = "lookup"
        description = "returns attacker-controlled text"
        args_schema: ClassVar[dict] = {"type": "object", "properties": {}}

        async def ainvoke(self, args: dict) -> str:
            return INJECTION

    async def _one_tool() -> list[object]:
        return [_PoisonedTool()]

    monkeypatch.setattr(generate_module, "agenerate", _fake_agenerate)
    monkeypatch.setattr(generate_module, "get_mcp_tools", _one_tool)

    state: State = {"message": "needs a tool", "blocked": False, "context_snippets": []}
    await generate_node(state)

    assert sent_back, "no tool_result was fed back — the tool loop did not run"
    assert "Ignore all previous instructions" not in sent_back[0]
    assert "[filtered]" in sent_back[0]


# ---------------------------------------------------------------------------
# Layer 3 — check_output on the answer
# ---------------------------------------------------------------------------


@pytest.mark.asyncio
async def test_generate_node_scrubs_credentials_from_the_answer(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """FAILS IF: the ``check_output(text)`` call is removed from the end_turn
    return in nodes/generate.py — the raw key then reaches the caller.
    """

    async def _fake_agenerate(system_prompt: str, messages: list[dict], tools=None):
        return _text_response(f"Your key is {FAKE_KEY} — keep it safe.")

    monkeypatch.setattr(generate_module, "agenerate", _fake_agenerate)
    monkeypatch.setattr(generate_module, "get_mcp_tools", _no_tools)

    state: State = {"message": "what is my key?", "blocked": False, "context_snippets": []}
    result = await generate_node(state)

    assert FAKE_KEY not in result["answer"]
    assert "[REDACTED_KEY]" in result["answer"]


@pytest.mark.asyncio
async def test_generate_node_scrubs_rather_than_blocks(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """FAILS IF: the layer-3 wiring branches on ``blocked`` and returns the
    refusal on a scrub hit. A leaked token must cost the token, not the answer —
    check_output scrubs and still delivers (see guardrails/README.md).
    """

    async def _fake_agenerate(system_prompt: str, messages: list[dict], tools=None):
        return _text_response(f"Descale every 2-3 months. Key: {FAKE_KEY}")

    monkeypatch.setattr(generate_module, "agenerate", _fake_agenerate)
    monkeypatch.setattr(generate_module, "get_mcp_tools", _no_tools)

    state: State = {"message": "how often?", "blocked": False, "context_snippets": []}
    result = await generate_node(state)

    assert "Descale every 2-3 months." in result["answer"]
    assert result["answer"] != guard_settings.refusal_message


@pytest.mark.asyncio
async def test_generate_node_leaves_a_clean_answer_exact(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """FAILS IF: the output filter rewrites text with no match — a scrubber that
    mangles clean answers passes the tests above while corrupting every response.
    """
    clean = "Descale every 2-3 months using a 1:4 solution mixture."

    async def _fake_agenerate(system_prompt: str, messages: list[dict], tools=None):
        return _text_response(clean)

    monkeypatch.setattr(generate_module, "agenerate", _fake_agenerate)
    monkeypatch.setattr(generate_module, "get_mcp_tools", _no_tools)

    state: State = {"message": "how often?", "blocked": False, "context_snippets": []}
    result = await generate_node(state)

    assert result["answer"] == clean
