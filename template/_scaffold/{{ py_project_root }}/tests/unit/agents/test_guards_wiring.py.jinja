# The retrieval half of layer 2 exists only when the corpus pipeline is
# scaffolded — copier.yaml removes nodes/retrieve.py otherwise. The tool half
# below is unconditional: MCP tools ship in every render.


def test_retrieve_node_filters_injection_out_of_snippets(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """A poisoned corpus document must be neutralized before it becomes a snippet.

    FAILS IF: the ``filter_content(...)`` call is removed from the
    ``context_snippets`` comprehension in nodes/retrieve.py — the raw injection
    text then reaches the prompt.

    ``search`` is patched rather than using the real index so this test runs in
    every render, including corpus-free ones where ``wired_vectordb`` is absent.
    """

    def _fake_search(_path: object, _query: str, k: int = 5) -> list[SimpleNamespace]:
        return [SimpleNamespace(id="poisoned", title="Descaling", text=INJECTION, score=1.0)]

    monkeypatch.setattr(retrieve_module, "search", _fake_search)

    result = retrieve_node({"message": "how do I descale?"})
    snippet = result["context_snippets"][0]

    assert "Ignore all previous instructions" not in snippet
    assert "[filtered]" in snippet
    # Neutralized, not dropped — the rest of the document survives.
    assert "Descaling" in snippet
    assert result["sources"][0].id == "poisoned"


def test_retrieve_node_filters_injection_in_the_title(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """FAILS IF: filter_content is applied to ``r.text`` only.

    A title is concatenated into the same prompt string as the body and is just
    as injectable; filtering the body alone leaves the seam open.
    """

    def _fake_search(_path: object, _query: str, k: int = 5) -> list[SimpleNamespace]:
        return [SimpleNamespace(id="p", title=INJECTION, text="Harmless body.", score=1.0)]

    monkeypatch.setattr(retrieve_module, "search", _fake_search)

    snippet = retrieve_node({"message": "q"})["context_snippets"][0]

    assert "Ignore all previous instructions" not in snippet
    assert "[filtered]" in snippet


def test_retrieve_node_leaves_clean_snippets_untouched(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """FAILS IF: the filter is wired to rewrite every snippet unconditionally.

    A layer that mangles clean text passes the two tests above while quietly
    degrading every answer.
    """

    def _fake_search(_path: object, _query: str, k: int = 5) -> list[SimpleNamespace]:
        return [
            SimpleNamespace(id="ok", title="Descaling", text="Descale every 2-3 months.", score=1.0)
        ]

    monkeypatch.setattr(retrieve_module, "search", _fake_search)

    snippet = retrieve_node({"message": "q"})["context_snippets"][0]

    assert snippet == "# Descaling\nDescale every 2-3 months."
