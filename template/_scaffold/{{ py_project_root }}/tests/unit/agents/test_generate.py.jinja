        return SimpleNamespace(
            stop_reason="end_turn",
            usage=SimpleNamespace(input_tokens=100, output_tokens=20),
            content=[SimpleNamespace(type="text", text="answer")],
        )

    async def _no_tools():
        return []

    monkeypatch.setattr(generate_module, "agenerate", _fake_agenerate)
    monkeypatch.setattr(generate_module, "get_mcp_tools", _no_tools)

    state: State = {"message": "hello", "blocked": False, "context_snippets": []}
    await generate_node(state)

    assert len(track_usage_calls) >= 1, (
        "track_usage was never called — context_budget is not wired into generate_node"
    )


@pytest.mark.asyncio
async def test_chat_span_token_attributes_reach_exported_span(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """Token counts and finish_reason must appear in the *exported* span, not just
    be passed to set_attribute on an already-ended span.

    The OTel Python SDK silently ignores set_attribute calls on ended spans
    (the span exits start_as_current_span on __exit__), so a Mock-based
    assertion that intercepts set_attribute call sites cannot distinguish
    between attributes that land and attributes that are dropped.

    This test injects an InMemorySpanExporter into the live TracerProvider
    that spans.py built at import time (using add_span_processor — the
    provider is already bound to the module-level _tracer, so new processors
    receive spans from all subsequent tracer.start_as_current_span calls).
    After generate_node returns the exporter holds the finished chat span;
    asserting on its .attributes proves the write landed while the span was
    still open.

    Failing modes:
    - Remove the ``with chat_span(...)`` block: no "chat" span exported → fails.
    - Dedent the ``if _span is not None:`` block outside the with: span ends
      before set_attribute is called → SDK drops the write → attributes stay
      at their creation-time values (0 / absent) → fails.
    - Remove the set_attribute calls entirely: same result → fails.
    """
    from opentelemetry.sdk.trace.export import SimpleSpanProcessor
    from opentelemetry.sdk.trace.export.in_memory_span_exporter import InMemorySpanExporter

    import observability.spans as spans_module

    exporter = InMemorySpanExporter()
    processor = SimpleSpanProcessor(exporter)

    # spans_module._provider is the TracerProvider bound at import. Adding a
    # processor here is safe: processors are invoked in registration order, and
    # the console processor already installed continues to work.
    spans_module._provider.add_span_processor(processor)
    try:
        _INPUT_TOKENS = 123
        _OUTPUT_TOKENS = 45
        _FINISH_REASON = "end_turn"

        async def _fake_agenerate(system_prompt: str, messages: list[dict], tools=None):
            return SimpleNamespace(
                stop_reason=_FINISH_REASON,
                usage=SimpleNamespace(input_tokens=_INPUT_TOKENS, output_tokens=_OUTPUT_TOKENS),
                content=[SimpleNamespace(type="text", text="spanned answer")],
            )

        async def _no_tools():
            return []

        monkeypatch.setattr(generate_module, "agenerate", _fake_agenerate)
        monkeypatch.setattr(generate_module, "get_mcp_tools", _no_tools)

        state: State = {"message": "hello", "blocked": False, "context_snippets": []}
        await generate_node(state)
    finally:
        # Remove the processor so it does not bleed into subsequent tests.
        # TracerProvider has no remove_span_processor; shutdown flushes and
        # prevents further exports from this processor only.
        processor.shutdown()

    finished = exporter.get_finished_spans()
    chat_spans = [s for s in finished if s.name == "chat"]
    assert chat_spans, "No 'chat' span exported — chat_span is not wired into generate_node"
    attrs = chat_spans[0].attributes
    assert attrs.get("gen_ai.usage.input_tokens") == _INPUT_TOKENS, (
        f"exported chat span has gen_ai.usage.input_tokens={attrs.get('gen_ai.usage.input_tokens')!r}, "
        f"expected {_INPUT_TOKENS} — set_attribute ran on an ended span (no-op) or was omitted"
    )
    assert attrs.get("gen_ai.usage.output_tokens") == _OUTPUT_TOKENS, (
        f"exported chat span has gen_ai.usage.output_tokens={attrs.get('gen_ai.usage.output_tokens')!r}, "
        f"expected {_OUTPUT_TOKENS} — set_attribute ran on an ended span (no-op) or was omitted"
    )
    assert attrs.get("gen_ai.response.finish_reasons") == _FINISH_REASON, (
        f"exported chat span has gen_ai.response.finish_reasons={attrs.get('gen_ai.response.finish_reasons')!r}, "
        f"expected {_FINISH_REASON!r} — set_attribute ran on an ended span (no-op) or was omitted"
    )


@pytest.mark.asyncio
async def test_truncated_response_logs_a_warning(
    monkeypatch: pytest.MonkeyPatch, caplog: pytest.LogCaptureFixture
) -> None:
    """stop_reason="max_tokens" must reach chat_span's truncation warning.

    chat_span decides the warning in its ``finally``, but the real finish reason
    is only known inside the block. Replace generate.py's
    ``record_finish_reason(_span, ...)`` with a bare ``_span.set_attribute(...)``
    and this test fails: the trace still gets the attribute, the log stays silent.
    """

    async def _fake_agenerate(system_prompt: str, messages: list[dict], tools=None):
        return SimpleNamespace(
            stop_reason="max_tokens",
            usage=SimpleNamespace(input_tokens=99, output_tokens=1024),
            content=[SimpleNamespace(type="text", text="a truncated ans")],
        )

    async def _no_tools():
        return []

    monkeypatch.setattr(generate_module, "agenerate", _fake_agenerate)
    monkeypatch.setattr(generate_module, "get_mcp_tools", _no_tools)

    state: State = {"message": "write me an essay", "blocked": False, "context_snippets": []}
    with caplog.at_level(logging.WARNING, logger="observability.spans"):
        await generate_node(state)

    assert "otel.chat.truncated" in caplog.text, (
        "a max_tokens stop_reason produced no truncation warning — the finish "
        "reason is not reaching chat_span's finally"
    )


@pytest.mark.asyncio
async def test_untruncated_response_logs_no_warning(
    monkeypatch: pytest.MonkeyPatch, caplog: pytest.LogCaptureFixture
) -> None:
    """The counterpart to the truncation test: end_turn must stay quiet."""

    async def _fake_agenerate(system_prompt: str, messages: list[dict], tools=None):
        return _text_response("a complete answer")

    async def _no_tools():
        return []

    monkeypatch.setattr(generate_module, "agenerate", _fake_agenerate)
    monkeypatch.setattr(generate_module, "get_mcp_tools", _no_tools)

    state: State = {"message": "hello", "blocked": False, "context_snippets": []}
    with caplog.at_level(logging.WARNING, logger="observability.spans"):
        await generate_node(state)

    assert "otel.chat.truncated" not in caplog.text, (
        "end_turn produced a truncation warning — the finish reason is leaking "
        "between calls or the comparison is wrong"
    )
